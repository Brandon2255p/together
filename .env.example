# Stub backend: in-memory seed data, any 6-digit code signs you in (000000 fails, to test errors)
USE_STUB_DATABASE=true
NEXT_PUBLIC_USE_STUB_DATABASE=true

# Real backend (Supabase) - used when the stub flags are false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Places API (New), server only: matches places saved from a Maps link, and shows their rating, hours and
# photo. Restrict the key to the Places API (New) and the server's IP, not to websites (server calls send no referrer).
# Optional: without it, places are saved with what the link itself says. See docs/deploy.md.
GOOGLE_MAPS_API_KEY=
