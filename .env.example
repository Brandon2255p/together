# Stub backend: in-memory seed data, any 6-digit code signs you in (000000 fails, to test errors)
USE_STUB_DATABASE=true
NEXT_PUBLIC_USE_STUB_DATABASE=true

# Real backend (Supabase) - used when the stub flags are false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Places API (New), server only: fills in a place's category, rating and photo when it's saved from a Maps
# link. Optional: without it, places are saved with what the link itself says. See docs/deploy.md.
GOOGLE_MAPS_API_KEY=
